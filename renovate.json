{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "timezone": "Europe/Berlin",
  "automergeSchedule": "* 3-4 * * *",
  "ignoreTests": true,
  "prHourlyLimit": 0,
  "assignees" : ["tlandsberger"],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor"],
      "matchPackageNames": [
        "traefik",
        "coredns/coredns",
        "cloudflare/cloudflared",
        "portainer/portainer-ce"
      ],
      "automerge": false
    },
    {
      "description": "Judo-Portal: Backend und Web immer gemeinsam aktualisieren",
      "matchPackageNames": [
        "ghcr.io/tlandsberger/judo-portal-backend",
        "ghcr.io/tlandsberger/judo-portal-web"
      ],
      "groupName": "judo-portal"
    }
  ]
}
